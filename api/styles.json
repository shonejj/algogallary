  "print": "Print",
  "ink": "Ink & Paint",
  "text": "Text Art",
  "pixel": "Pixel & Dither",
  "geometry": "Geometry",
  "math": "Math Art",
  "shader": "Shader Art",
  "illustration": "Illustration",
  "typography": "Typography",
  "webdesign": "Web Design"
 },
