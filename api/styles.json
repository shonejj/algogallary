{
 "name": "AlgoGallery",
 "license": "CC0-1.0",
 "endpoint": "render.html",
 "viewer": "index.html",
 "params": {
  "note": "see README for the full list (mix, blend, mask, shape, xa, xb, warp, colors, world and creature controls, effects)",
  "mode": "image|video",
  "style": "id or comma list",
  "cat": "category ids",
  "seed": "uint32",
  "palette": "auto|random|<name>",
  "fx": "auto|none|film|crt|vhs|glitch|bitmap|dither|gameboy|pixel|halftone|cmyk|ascii|matrix|stipple|duotone|paper",
  "w": "px",
  "h": "px",
  "aspect": "1:1|4:5|9:16|16:9",
  "dur": "seconds (video)",
  "download": "1 = auto-save file"
 },
